NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed solely for the controlled enquiry endpoint.
SUPABASE_SERVICE_ROLE_KEY=
# Set to the final HTTPS origin before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Preview fixtures are used ONLY without Supabase, and never in production unless explicitly enabled.
ALLOW_DEMO_PREVIEW=false
# Optional Google Analytics ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# ImageKit configuration
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/9nwmg4m7o
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
# Server only. Private API key for secure backend image storage and uploads. Never expose to client.
IMAGEKIT_PRIVATE_KEY=

# Admin Security & JWT Authentication Configuration
# Cryptographically strong secret for HMAC-SHA256 access tokens (e.g. 64-char hex string).
JWT_ACCESS_SECRET=
# Cryptographically strong secret for refresh token cryptographic hashing.
JWT_REFRESH_SECRET=
# Access token lifetime in seconds (default: 900 = 15 minutes)
JWT_ACCESS_TOKEN_TTL=900
# Refresh token lifetime in seconds (default: 604800 = 7 days)
JWT_REFRESH_TOKEN_TTL=604800
# JWT claims
JWT_ISSUER=achu-boutique
JWT_AUDIENCE=achu-boutique-admin

# Standalone Admin Account Provisioning (generate via: npx tsx scripts/bootstrap-admin.ts)
ADMIN_ID=achu
ADMIN_EMAIL=admin@achuboutique.com
ADMIN_PASSWORD_HASH=
